# Copy to .env for local development, or inject these variables in production.
# Never commit real credentials or secrets.

NODE_ENV=development
PORT=3001
DATA_DIR=./data
# DB_PATH=./data/lab.db

RESEARCHER_USERNAME=researcher
# Production requires a password of at least 8 characters.
RESEARCHER_PASSWORD=replace-with-a-long-password
# At least 24 characters. If omitted, a local file is generated in DATA_DIR.
AUTH_SECRET=replace-with-a-random-secret-at-least-24-chars

# Build-time frontend variable. Leave empty to show a generic contact note.
VITE_LAB_CONTACT_EMAIL=
